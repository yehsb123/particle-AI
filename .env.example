# ─────────────────────────────────────────────────────────────
# Digital Matter — environment configuration
# Copy to .env and fill in. NEVER commit real secrets.
# The system runs fully in deterministic/mock mode with none of these set.
# ─────────────────────────────────────────────────────────────

# Runtime
DM_PORT=8787
DM_LOG_LEVEL=info

# Database (Phase 8 — optional; runtime uses in-memory store until enabled)
DATABASE_URL=postgres://dm:dm@localhost:5432/digital_matter

# Intelligence providers (all optional — MockProvider is used when absent)
DM_DEFAULT_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local model provider (OpenAI-compatible HTTP endpoint, e.g. Ollama/LM Studio)
DM_LOCAL_MODEL_BASE_URL=
DM_LOCAL_MODEL_NAME=
