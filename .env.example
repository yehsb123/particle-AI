# ─────────────────────────────────────────────────────────────
# Particle AI — environment configuration
# Copy to .env and fill in. NEVER commit real secrets.
# The system runs fully in deterministic/mock mode with NONE of these set.
# ─────────────────────────────────────────────────────────────

# Runtime server
DM_PORT=8787
# Bind address. Loopback by default — set 0.0.0.0 only if you really want the runtime reachable on your LAN.
DM_HOST=127.0.0.1
DM_LOG_LEVEL=info
# Browser origins allowed to talk to the runtime (the body). chrome-extension:// origins are always allowed.
DM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional shared secret: when set, every POST must carry `x-particle-token` (extension options / agent env)
DM_INGEST_TOKEN=

# Database (optional; runtime uses in-memory stores until enabled)
# Windows tip: use 127.0.0.1, not localhost (localhost may resolve to IPv6 ::1)
DATABASE_URL=postgres://dm:dm@127.0.0.1:5432/digital_matter
# Read by docker-compose.yml only (not by the code): host port for the local Postgres container.
# Set it when 5432 is already taken, and use the same port in DATABASE_URL above.
DM_PG_PORT=5432

# Intelligence providers (all optional — the deterministic MockProvider is used when absent)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local model provider (OpenAI-compatible HTTP endpoint, e.g. Ollama/LM Studio)
DM_LOCAL_MODEL_BASE_URL=
DM_LOCAL_MODEL_NAME=

# AI accounts you are already signed into in a browser — comma-separated hosts, e.g.
# claude.ai,chatgpt.com. Declaring one only makes it visible as a linked account: driving a
# signed-in session is NOT built, so nothing here touches your browser, your cookies or your
# session, and the runtime keeps thinking with the providers above.
DM_BROWSER_SESSIONS=

# Web (connected mode) — where the browser reaches the runtime server
NEXT_PUBLIC_RUNTIME_URL=http://localhost:8787
# Token the standalone web body sends when DM_INGEST_TOKEN is set (the side panel passes it via its URL)
NEXT_PUBLIC_DM_TOKEN=

# Desktop agent (Concept v2 L4, OPT-IN — does nothing unless DM_WATCH_PATHS is set or output is piped)
DM_RUNTIME_URL=http://localhost:8787
DM_AGENT_SESSION=desktop
# comma-separated directories whose file SAVES (relative paths only, never contents) are sensed
DM_WATCH_PATHS=
# How long a burst of saves is collected before one event is sent (ms). Leave empty for the default.
DM_AGENT_DEBOUNCE_MS=400
# Sense WHICH APPLICATION WINDOW IS IN FRONT (Windows only; program name and window title only,
# never what is in the window). Browser windows are left to the extension, which reports tabs.
# 1/true/yes/on turns it on; empty, 0/false/no/off leave it off.
DM_WATCH_WINDOWS=
# How often the window in front is read (ms). Leave empty for the default.
DM_AGENT_WINDOW_MS=1000

# Screen capture (opt-in, off by default; the one layer that reads content rather than shape).
# A frame is written to a file and travels as a filename: the pixels never leave this machine.
# The desktop agent photographs the apps in DM_CAPTURE_APPS below; this is the camera's own
# switch, and both have to be set before any picture is taken.
DM_CAPTURE=
# Which programs the desktop agent may photograph, by process name, comma-separated. EMPTY MEANS
# NONE and is the default: with nothing here the agent behaves exactly as it did without this
# layer. At most 8, because a list long enough to cover a desktop is the photograph-everything
# option this layer refuses to have. Needs DM_WATCH_WINDOWS=1 as well, since what is photographed
# is the listed app you are in.
# Which apps belong here: the ones the accessibility interface cannot read. Measured on Windows
# 11 — Hancell names every menu and button, so photographing it adds nothing; KakaoTalk answers
# with six unnamed panes and no conversation list, so a picture is the only way to read it.
# Browsers are never photographed whatever you write here: the extension reports those tabs.
DM_CAPTURE_APPS=
# The shortest time between two pictures of one app (ms). The window in front is read every
# second, so this is what stands between an afternoon in a chat window and an afternoon of
# pictures of it. Leave empty for the default (60000).
DM_AGENT_CAPTURE_MS=
# Where frames are written. Empty means the temp directory. The consent wording in the body
# names this path, so if you change it the body says the new one.
DM_CAPTURE_DIR=
# Which backend draws the frame. windows is the default and is MIT; obs is GPL and lives in its
# own package, which nothing in the default build imports.
DM_CAPTURE_BACKEND=windows
# Defaults for the command-line tool when a flag is not given.
DM_CAPTURE_TARGET=
DM_CAPTURE_APP=
DM_CAPTURE_PATH=
DM_CAPTURE_TIMEOUT_MS=

# The OBS backend, only read by packages/screen-capture-obs (GPL). Leave empty unless you chose it.
# DM_OBS_PASSWORD is a secret: put the real one in .env, never here.
DM_OBS_URL=
DM_OBS_PASSWORD=
DM_OBS_SOURCE=

# Tests only, not runtime configuration: SHOTS=1 turns e2e/store-shots.spec.ts from a skipped
# test into the Chrome Web Store screenshot generator. Listed here so this file stays the whole
# list of what the code reads.
# SHOTS=
