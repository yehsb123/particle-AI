{
  "name": "digital-matter",
  "version": "0.0.1",
  "private": true,
  "description": "An experimental runtime that reshapes the interface around your work: ten sensing layers read shape only, never content, and two more read a screen and a page when you turn them on.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "web": "pnpm --filter @particle/web dev",
    "runtime": "pnpm --filter @particle/runtime dev",
    "agent": "pnpm --filter @particle/agent start"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
